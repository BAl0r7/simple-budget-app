    function computeAutoMascotMood() {
      if (state.mascotOverrideMood) return state.mascotOverrideMood;
      const stats = getMonthStats(state.activeMonth);
      const pct = state.monthlyBudgetLimit > 0 ? (stats.expense / state.monthlyBudgetLimit) * 100 : 0;
      if (pct >= 100) return 'SHOCKED';
      if (pct >= 75) return 'WORRIED';
      return 'CALM';
    }

    function cycleMascotMood() {
      const order = [null, 'CALM', 'WHISTLE', 'WORRIED', 'SHOCKED', 'HAPPY'];
      const idx = order.indexOf(state.mascotOverrideMood);
      state.mascotOverrideMood = order[(idx + 1) % order.length];
      renderHeaderAndMascot();
      const mood = computeAutoMascotMood();
      showToast(`Penny Mood: ${mood}`);
    }

