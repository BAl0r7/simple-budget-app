    function saveModalTransaction() {
      let rawAmt = document.getElementById('modalAmountInput').value;
      try {
        const sanitized = String(rawAmt).replace(/[^0-9+\-*/.]/g, '');
        rawAmt = Function(`"use strict"; return (${sanitized || 0})`)();
      } catch (e) {}
      const amt = Number(rawAmt) || 0;
      if (amt <= 0) {
        showToast('Please enter an amount greater than 0');
        return;
      }

      const desc = document.getElementById('modalDescInput').value.trim() || state.selectedCategory;
      const isInc = state.modalType === 'income';

      if (state.editingTxId) {
        const idx = state.sheets[state.activeMonth].findIndex(r => r.id === state.editingTxId);
        if (idx > -1) {
          state.sheets[state.activeMonth][idx] = {
            ...state.sheets[state.activeMonth][idx],
            date: state.selectedDate,
            paymentType: state.selectedPayment,
            category: state.selectedCategory,
            description: desc,
            expense: isInc ? 0 : amt,
            income: isInc ? amt : 0
          };
        }
      } else {
        state.sheets[state.activeMonth].unshift({
          id: 'tx_' + Date.now(),
          date: state.selectedDate,
          paymentType: state.selectedPayment,
          category: state.selectedCategory,
          description: desc,
          expense: isInc ? 0 : amt,
          income: isInc ? amt : 0
        });

        if (document.getElementById('modalRecurringCheck').checked) {
          const day = Number(document.getElementById('modalRecurringDayInput').value) || 5;
          state.recurringRules.push({
            id: 'rec_' + Date.now(),
            title: desc,
            amount: amt,
            type: state.modalType,
            category: state.selectedCategory,
            paymentType: state.selectedPayment,
            day
          });
        }
      }

      state.mascotOverrideMood = isInc ? 'HAPPY' : 'WHISTLE';
      setTimeout(() => { state.mascotOverrideMood = null; renderHeaderAndMascot(); }, 3000);

      saveState();
      renderAll();
      closeAddEntryModal();
      showToast(state.editingTxId ? 'Transaction updated ✓' : 'Transaction saved ✓');
    }

