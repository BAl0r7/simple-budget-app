    function renderHomeVisualGraphics(stats) {
      const cur = state.currency;
      const donutBox = document.getElementById('homeDonutChartBox');
      const legendBox = document.getElementById('homeDonutLegend');
      const catList = document.getElementById('homeCategorySpendEarnList');
      if (!donutBox || !legendBox || !catList) return;

      const palette = ['#10B981', '#38BDF8', '#F59E0B', '#EC4899', '#A855F7', '#F43F5E'];
      const entries = Object.entries(stats.catExpense).sort((a, b) => b[1] - a[1]);
      const totalExp = stats.expense || 1;

      // SVG Donut Chart
      let cumulativePct = 0;
      const circles = entries.slice(0, 5).map(([cat, amt], idx) => {
        const pct = (amt / totalExp) * 100;
        const dashArray = `${pct} ${100 - pct}`;
        const dashOffset = 25 - cumulativePct;
        cumulativePct += pct;
        return `<circle cx="18" cy="18" r="15.915" fill="transparent" stroke="${palette[idx % palette.length]}" stroke-width="3.8" stroke-dasharray="${dashArray}" stroke-dashoffset="${dashOffset}"></circle>`;
      }).join('');

      donutBox.innerHTML = `
        <svg viewBox="0 0 36 36" class="w-full h-full">
          <circle cx="18" cy="18" r="15.915" fill="transparent" stroke="#102D23" stroke-width="3.8"></circle>
          ${circles}
        </svg>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
          <span class="text-[9px] app-muted uppercase">Spent</span>
          <span class="text-xs font-mono font-extrabold text-white">${cur}${stats.expense.toLocaleString('en-IN')}</span>
        </div>
      `;

      legendBox.innerHTML = entries.slice(0, 4).map(([cat, amt], idx) => {
        const pct = Math.round((amt / totalExp) * 100);
        return `
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-1.5 truncate">
              <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background:${palette[idx % palette.length]}"></span>
              <span class="truncate font-semibold">${cat}</span>
            </div>
            <span class="font-mono text-[11px] app-muted">${pct}% (${cur}${amt})</span>
          </div>
        `;
      }).join('') || `<div class="text-xs app-muted">Add expenses to view chart</div>`;

      // Combined Spend & Earn Per Category
      const allCats = Array.from(new Set([...Object.keys(stats.catincome || {}), ...Object.keys(stats.catIncome || {}), ...Object.keys(stats.catExpense || {})]));
      catList.innerHTML = allCats.map(cat => {
        const spent = stats.catExpense[cat] || 0;
        const earned = stats.catIncome[cat] || 0;
        const pct = Math.min(100, Math.round((spent / totalExp) * 100));
        return `
          <div class="p-2.5 rounded-xl app-elevated space-y-1">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold">${cat}</span>
              <div class="flex items-center gap-2 font-mono text-[11px]">
                ${earned > 0 ? `<span class="text-emerald-400 font-bold">+${cur}${earned.toLocaleString('en-IN')}</span>` : ''}
                ${spent > 0 ? `<span class="text-rose-400 font-bold">-${cur}${spent.toLocaleString('en-IN')}</span>` : ''}
              </div>
            </div>
            ${spent > 0 ? `
              <div class="w-full h-1.5 bg-black/40 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-[#38BDF8] to-[#10B981]" style="width:${pct}%"></div>
              </div>
            ` : ''}
          </div>
        `;
      }).join('');
    }

