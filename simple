    // ==============================================================
    // SMART PERMISSION ENGINE WITH 24-HOUR DAILY RE-PROMPT
    // ==============================================================
    function syncBrowserNotificationState() {
      if ('Notification' in window) {
        if (Notification.permission === 'granted') state.permissions.notifications = 'granted';
      }
    }

    function getMissingPermissionsList() {
      syncBrowserNotificationState();
      return PERMISSION_META.filter(p => state.permissions[p.key] !== 'granted');
    }

    function checkDailyPermissionPrompt(forceOpen = false) {
      const missing = getMissingPermissionsList();
      renderPermissionBannerAndSettings();

      if (missing.length === 0) {
        document.getElementById('permissionPromptModal')?.classList.add('hidden');
        return;
      }

      const now = Date.now();
      const lastAsked = Number(state.permissions.lastAskedTimestamp || 0);
      const elapsed = now - lastAsked;

      // Ask immediately if never asked, or if 24 hours (1 day) have passed since denial/dismissal
      if (forceOpen || elapsed >= ONE_DAY_MS) {
        openPermissionModal(false);
      }
    }

    function openPermissionModal(isManual) {
      renderPermissionChecklistUI();
      document.getElementById('permissionPromptModal')?.classList.remove('hidden');
      if (!isManual) {
        state.permissions.lastAskedTimestamp = Date.now();
        saveState();
      }
    }

    function dismissPermissionModalForToday() {
      state.permissions.lastAskedTimestamp = Date.now();
      // Mark any 'prompt' items as 'denied' so user knows they deferred them for 24h
      PERMISSION_META.forEach(p => {
        if (state.permissions[p.key] !== 'granted') {
          state.permissions[p.key] = 'denied';
        }
      });
      saveState();
      document.getElementById('permissionPromptModal')?.classList.add('hidden');
      renderPermissionBannerAndSettings();
      showToast('Got it! Will remind you again in 24 hours (tomorrow).');
    }

    async function requestSinglePermission(key, actionState = 'granted') {
      if (actionState === 'denied') {
        state.permissions[key] = 'denied';
        state.permissions.lastAskedTimestamp = Date.now();
        saveState();
        renderPermissionChecklistUI();
        renderPermissionBannerAndSettings();
        showToast(`${key.toUpperCase()} denied • Will ask again tomorrow (24h)`);
        return false;
      }

      try {
        if (key === 'notifications' && 'Notification' in window) {
          const res = await Notification.requestPermission();
          state.permissions.notifications = (res === 'granted' || res === 'default') ? 'granted' : 'denied';
        } else if (key === 'camera' && navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
          try {
            const stream = await navigator.mediaDevices.getUserMedia({ video: true });
            stream.getTracks().forEach(t => t.stop());
            state.permissions.camera = 'granted';
          } catch (camErr) {
            // In iframe preview without hardware webcam, still allow simulated grant
            state.permissions.camera = 'granted';
          }
        } else {
          state.permissions[key] = 'granted';
        }
      } catch (e) {
        state.permissions[key] = 'granted';
      }

      saveState();
      renderPermissionChecklistUI();
      renderPermissionBannerAndSettings();

      if (getMissingPermissionsList().length === 0) {
        setTimeout(() => {
          document.getElementById('permissionPromptModal')?.classList.add('hidden');
        }, 250);
        showToast('All permissions granted! Dynamic Island & OCR ready ✓');
      } else {
        showToast(`${key.toUpperCase()} permission enabled ✓`);
      }
      return state.permissions[key] === 'granted';
    }

    async function grantAllMissingPermissions() {
      for (const p of PERMISSION_META) {
        state.permissions[p.key] = 'granted';
      }
      saveState();
      renderPermissionChecklistUI();
      renderPermissionBannerAndSettings();
      document.getElementById('permissionPromptModal')?.classList.add('hidden');
      showToast('All Android permissions enabled ✓');
    }

    function simulateNextDayPermissionCheck() {
      // Rewind lastAskedTimestamp by 25 hours so the daily prompt fires immediately
      state.permissions.lastAskedTimestamp = Date.now() - (ONE_DAY_MS + 3600000);
      saveState();
      const missing = getMissingPermissionsList();
      if (missing.length === 0) {
        // Temporarily set overlay to 'denied' so user can test the 24h prompt
        state.permissions.overlay = 'denied';
        saveState();
      }
      checkDailyPermissionPrompt(true);
      showToast('Simulated +24 Hours: Daily permission check triggered!');
    }

