<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="theme-color" content="#04120E" />
  <title>Simple Budget — Commercial Pro Edition</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- SheetJS for Multi-Tab Excel (.xlsx) Backup & Restore -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <!-- Google Fonts: Inter, JetBrains Mono & Space Mono (Nothing OS style) -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&family=Space+Mono:wght@400;700&display=swap" signature="true" rel="stylesheet">

  <style>
    :root {
      /* Default: Blue & Emerald Wealth Blend */
      --bg-main: #04120E;
      --bg-card: #091E17;
      --bg-elevated: #102D23;
      --border-color: #194234;
      --text-main: #F3F8F6;
      --text-muted: #8AA399;
      --accent-primary: #10B981;
      --accent-secondary: #38BDF8;
      --accent-gradient: linear-gradient(135deg, #38BDF8 0%, #10B981 100%);
      --accent-fg: #03150F;
      --anim-speed: 0.32s;
    }

    /* Theme 2: Ocean Blue Trust */
    body.theme-ocean {
      --bg-main: #040D1A;
      --bg-card: #0A192F;
      --bg-elevated: #112240;
      --border-color: #1E3A63;
      --text-main: #F0F6FC;
      --text-muted: #8B9EB7;
      --accent-primary: #38BDF8;
      --accent-secondary: #6366F1;
      --accent-gradient: linear-gradient(135deg, #38BDF8 0%, #2563EB 100%);
      --accent-fg: #040D1A;
    }

    /* Theme 3: OLED Pure Monochrome */
    body.theme-oled {
      --bg-main: #000000;
      --bg-card: #0D0D0D;
      --bg-elevated: #171717;
      --border-color: #262626;
      --text-main: #FFFFFF;
      --text-muted: #8E8E93;
      --accent-primary: #FFFFFF;
      --accent-secondary: #A3A3A3;
      --accent-gradient: linear-gradient(135deg, #FFFFFF 0%, #D4D4D8 100%);
      --accent-fg: #000000;
    }

    /* Theme 4: Warm Paper Light */
    body.theme-paper {
      --bg-main: #F5F5F2;
      --bg-card: #FFFFFF;
      --bg-elevated: #EAEAE4;
      --border-color: #D6D6CE;
      --text-main: #111815;
      --text-muted: #5B6660;
      --accent-primary: #059669;
      --accent-secondary: #0284C7;
      --accent-gradient: linear-gradient(135deg, #0284C7 0%, #059669 100%);
      --accent-fg: #FFFFFF;
    }

    /* Ultra Low-Battery Saver Mode for Older Android Phones */
    body.perf-saver * {
      animation: none !important;
      transition: none !important;
      backdrop-filter: none !important;
      box-shadow: none !important;
    }

    * {
      -webkit-tap-highlight-color: transparent;
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-main);
      color: var(--text-main);
      overscroll-behavior-y: none;
      overflow-x: hidden;
    }

    .font-mono { font-family: 'JetBrains Mono', monospace; }

    .app-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      color: var(--text-main);
    }

    .app-elevated {
      background-color: var(--bg-elevated);
      border: 1px solid var(--border-color);
      color: var(--text-main);
    }

    .app-muted { color: var(--text-muted); }

    .app-gradient-btn {
      background: var(--accent-gradient);
      color: var(--accent-fg);
    }

    /* 120Hz / 90Hz Hardware Accelerated Island & Modals */
    .gpu-smooth {
      transform: translate3d(0, 0, 0);
      backface-visibility: hidden;
      will-change: transform, opacity;
      transition: all var(--anim-speed) cubic-bezier(0.22, 1, 0.36, 1);
    }

    @keyframes floatNote1 {
      0% { transform: translate3d(0, 0, 0) scale(0.75); opacity: 0; }
      45% { opacity: 1; }
      100% { transform: translate3d(14px, -16px, 0) scale(1.2); opacity: 0; }
    }
    @keyframes floatNote2 {
      0% { transform: translate3d(0, 0, 0) scale(0.7); opacity: 0; }
      55% { opacity: 1; }
      100% { transform: translate3d(20px, -8px, 0) scale(1.1); opacity: 0; }
    }
    @keyframes sweatDrop {
      0% { transform: translate3d(0, 0, 0); opacity: 0.95; }
      70% { transform: translate3d(0, 8px, 0); opacity: 0.95; }
      100% { transform: translate3d(0, 11px, 0); opacity: 0; }
    }
    @keyframes scanLaser {
      0% { top: 8%; }
      50% { top: 88%; }
      100% { top: 8%; }
    }

    .whistle-note-1 { animation: floatNote1 1.5s infinite ease-out; }
    .whistle-note-2 { animation: floatNote2 1.8s infinite 0.35s ease-out; }
    .sweat-anim { animation: sweatDrop 1.3s infinite ease-in; }
    .ocr-laser { animation: scanLaser 2.2s infinite ease-in-out; }

    /* Modern Glassmorphic Financial Memo Pad */
    .memo-paper {
      background: linear-gradient(165deg, rgba(16, 45, 35, 0.75) 0%, rgba(9, 30, 23, 0.95) 100%);
      border: 1px solid var(--border-color);
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    }
    .memo-ruled {
      background-image: linear-gradient(to bottom, transparent 27px, rgba(56, 189, 248, 0.08) 28px);
      background-size: 100% 28px;
      line-height: 28px;
    }

    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(56, 189, 248, 0.25); border-radius: 9999px; }
  </style>
</head>

<body class="min-h-screen flex flex-col items-center justify-start">

  <!-- BIOMETRIC SCREEN LOCK OVERLAY -->
  <div id="biometricLockOverlay" class="fixed inset-0 z-[90] hidden bg-[#030F0B]/95 backdrop-blur-xl flex flex-col items-center justify-center p-6 text-center">
    <div class="w-20 h-20 rounded-3xl app-card flex items-center justify-center mb-4 shadow-2xl border border-[#38BDF8]/40">
      <div id="lockScreenMascot" class="w-14 h-14"></div>
    </div>
    <h2 class="text-lg font-extrabold tracking-tight">Simple Budget Locked</h2>
    <p class="text-xs app-muted mt-1 max-w-[260px]">Authenticate with Fingerprint or Face Unlock to view your financial ledger.</p>
    <button onclick="unlockWithBiometrics()" class="mt-6 px-6 py-3.5 rounded-2xl app-gradient-btn font-extrabold text-xs flex items-center gap-2 shadow-xl active:scale-95 transition">
      <span>🔐</span>
      <span>Touch Fingerprint / Face Unlock</span>
    </button>
  </div>

  <!-- ========================================================== -->
  <!-- ANDROID PERMISSION GATEKEEPER & 24-HOUR DAILY RE-PROMPT    -->
  <!-- ========================================================== -->
  <div id="permissionPromptModal" class="fixed inset-0 z-[85] hidden bg-black/85 backdrop-blur-md flex items-center justify-center p-4">
    <div class="app-card w-full max-w-[395px] rounded-3xl p-5 space-y-4 shadow-2xl border border-[#38BDF8]/40">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div id="permMascotBox" class="w-11 h-11 rounded-2xl app-elevated p-1 shrink-0"></div>
          <div>
            <div class="flex items-center gap-1.5">
              <h3 class="text-sm font-extrabold">Required App Permissions</h3>
              <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-400 font-bold">ANDROID</span>
            </div>
            <p id="permCooldownSubtitle" class="text-[10.5px] app-muted">Needed for Dynamic Island UPI & OCR</p>
          </div>
        </div>
        <button onclick="dismissPermissionModalForToday()" class="p-1.5 rounded-xl app-elevated text-xs" title="Remind me tomorrow">✕</button>
      </div>

      <p class="text-[11px] app-muted leading-relaxed">
        To detect GPay/PhonePe payments in the Dynamic Island and scan receipts, Simple Budget needs the following permissions. <span class="text-[#38BDF8] font-semibold">If denied, we will only remind you once per day.</span>
      </p>

      <!-- Individual Permission Checklist -->
      <div id="permissionChecklistContainer" class="space-y-2 max-h-[270px] overflow-y-auto pr-0.5"></div>

      <!-- Actions -->
      <div class="grid grid-cols-2 gap-2 pt-1">
        <button onclick="dismissPermissionModalForToday()" class="py-2.5 rounded-2xl app-elevated font-bold text-xs text-[#8AA399] hover:text-white">
          Ask Tomorrow (24h)
        </button>
        <button onclick="grantAllMissingPermissions()" class="py-2.5 rounded-2xl app-gradient-btn font-extrabold text-xs shadow-lg">
          ✓ Allow All Required
        </button>
      </div>
    </div>
  </div>

  <!-- MAIN MOBILE SHELL -->
  <div class="w-full max-w-[445px] min-h-screen flex flex-col relative pb-28">

    <!-- TOP STATUS & BACKGROUND SIMULATION BAR -->
    <div class="px-3 pt-2.5 z-40 space-y-1.5">
      <div class="app-card rounded-2xl p-2 flex items-center justify-between gap-2 shadow-lg">
        <div class="flex items-center gap-2 min-w-0 pl-1">
          <span id="appStateDot" class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0"></span>
          <span id="appStateText" class="text-[11px] font-semibold truncate">In-App Mode (Island Standby)</span>
        </div>
        <button id="bgToggleBtn" onclick="toggleBackgroundSimulation()" class="px-3 py-1.5 rounded-xl text-[11px] font-bold app-gradient-btn active:scale-95 transition shrink-0">
          📱 Minimize App (Test Island)
        </button>
      </div>

      <!-- MISSING PERMISSION WARNING BANNER (SHOWN IF ANY PERMISSION IS DENIED) -->
      <div id="missingPermBanner" onclick="openPermissionModal(true)" class="hidden app-card border border-amber-500/40 bg-amber-500/10 rounded-2xl px-3 py-2 flex items-center justify-between gap-2 cursor-pointer">
        <div class="flex items-center gap-2 min-w-0">
          <span class="text-xs">⚠️</span>
          <span id="missingPermBannerText" class="text-[10.5px] font-semibold text-amber-300 truncate">Permissions missing for Dynamic Island • Tap to review</span>
        </div>
        <span class="text-[10px] font-mono font-extrabold px-2 py-0.5 rounded-lg bg-amber-400 text-black shrink-0">Fix</span>
      </div>
    </div>

    <!-- ========================================================== -->
    <!-- BACKGROUND PHONE HOME SCREEN (DYNAMIC ISLAND ONLY HERE)    -->
    <!-- ========================================================== -->
    <div id="backgroundPhoneScreen" class="hidden flex-col items-center justify-between flex-1 px-4 py-3">
      
      <!-- PUNCH-HOLE DYNAMIC ISLAND OVERLAY -->
      <div class="w-full flex flex-col items-center pt-1">
        <div id="dynamicIsland" onclick="expandDynamicIsland()"
             class="gpu-smooth bg-[#020B08] text-white border border-[#1E4E3D] rounded-[30px] w-[285px] h-[46px] px-3.5 flex flex-col justify-between overflow-hidden cursor-pointer shadow-[0_14px_45px_rgba(0,0,0,0.92)]">
          
          <!-- Compact Pill Header -->
          <div class="w-full h-[44px] shrink-0 flex items-center justify-between gap-2 select-none">
            <div class="flex items-center gap-2 min-w-0">
              <div id="islandCatMini" class="w-7 h-7 shrink-0 flex items-center justify-center"></div>
              <!-- Simulated POCO X6 Pro Front Camera Cutout -->
              <div class="w-3 h-3 rounded-full bg-black border border-neutral-800 shrink-0"></div>
              <div id="islandCompactLabel" class="text-[11.5px] font-semibold tracking-tight truncate text-[#38BDF8]">
                Waiting for UPI / Salary...
              </div>
            </div>
            <span id="islandActionPill" class="text-[10px] font-mono font-extrabold px-2.5 py-0.5 rounded-full app-gradient-btn shrink-0">
              ♪ LOG
            </span>
          </div>

          <!-- Expanded Dynamic Island Body (With Expense vs Salary/Income Toggle!) -->
          <div id="islandExpandedBody" class="hidden flex-col gap-2.5 pt-2 pb-3.5 text-left border-t border-[#194234] mt-1">
            <div class="flex items-center justify-between bg-[#081A14] px-3 py-2 rounded-2xl border border-[#194234]">
              <div class="flex items-center gap-2.5">
                <div id="islandCatLarge" class="w-11 h-11 shrink-0"></div>
                <div>
                  <div id="islandWhistleTitle" class="text-xs font-extrabold text-white">Penny Whistling ♪ ♫</div>
                  <div class="text-[10px] text-[#8AA399]">Auto-parsed from Android notification</div>
                </div>
              </div>
              <button onclick="collapseDynamicIsland(event)" class="p-1.5 rounded-full bg-[#102D23] text-[#8AA399] hover:text-white text-xs">✕</button>
            </div>

            <!-- Expense (-) vs Salary / Income (+) Switch inside Island -->
            <div class="grid grid-cols-2 gap-1.5 p-1 rounded-xl bg-[#081A14] border border-[#194234]">
              <button type="button" id="islandBtnExp" onclick="event.stopPropagation(); setIslandType('expense')" class="py-1.5 rounded-lg text-xs font-extrabold app-gradient-btn">
                💸 Expense (OUT)
              </button>
              <button type="button" id="islandBtnInc" onclick="event.stopPropagation(); setIslandType('income')" class="py-1.5 rounded-lg text-xs font-extrabold text-[#8AA399]">
                💰 Salary / Income (+)
              </button>
            </div>

            <!-- Amount & Date -->
            <div class="grid grid-cols-12 gap-2">
              <div class="col-span-7 relative">
                <span class="curr-symbol absolute left-3 top-1/2 -translate-y-1/2 text-sm font-mono font-bold text-[#38BDF8]">₹</span>
                <input id="islandInputAmount" type="number" step="any" onclick="event.stopPropagation()" placeholder="0"
                       class="w-full bg-[#081A14] border border-[#194234] focus:border-[#38BDF8] rounded-xl py-2 pl-7 pr-2 text-sm font-mono font-bold text-white outline-none" />
              </div>
              <div class="col-span-5">
                <button type="button" id="islandDateBtn" onclick="event.stopPropagation(); openCalendarModal('island')"
                        class="w-full h-full bg-[#081A14] border border-[#194234] rounded-xl py-2 px-2 text-center text-xs font-mono font-bold text-white flex items-center justify-center gap-1">
                  <span>📅</span>
                  <span id="islandDateText">8-Nov</span>
                </button>
              </div>
            </div>

            <!-- Payment Type Chips in Island -->
            <div id="islandPaymentChips" class="flex gap-1.5 overflow-x-auto pb-0.5"></div>

            <!-- Category Chips in Island -->
            <div id="islandCategoryChips" class="flex flex-wrap gap-1.5 max-h-[76px] overflow-y-auto"></div>

            <!-- Merchant Note + 1-Tap Save -->
            <div class="flex gap-2 pt-0.5">
              <input id="islandInputNote" type="text" onclick="event.stopPropagation()" placeholder="Note / Merchant / Salary..."
                     class="flex-1 bg-[#081A14] border border-[#194234] rounded-xl px-3 py-2 text-xs text-white outline-none" />
              <button onclick="saveFromDynamicIsland(event)" class="app-gradient-btn font-extrabold text-xs px-4 py-2 rounded-xl shrink-0 shadow-lg">
                ✓ Save
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Simulated Android Home Screen Triggers -->
      <div class="app-card rounded-3xl p-5 text-center space-y-3.5 my-auto w-full shadow-2xl">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full app-elevated text-[11px] font-mono text-[#38BDF8]">
          <span>⚡ Android Background Notification Simulator</span>
        </div>
        <h3 class="text-sm font-extrabold">Test UPI Payment & Salary Inflow</h3>
        <p class="text-xs app-muted">Since Simple Budget is minimized, any UPI payment or Salary SMS triggers Penny in the Dynamic Island above:</p>
        
        <div class="grid grid-cols-2 gap-2.5 text-left">
          <button onclick="triggerBackgroundUpi('UPI Lite', 260, 'Food', 'Shalimar Dum Biryani', false)" class="p-3 rounded-2xl app-elevated hover:border-[#38BDF8] transition active:scale-95">
            <div class="text-xs font-extrabold text-[#38BDF8]">⚡ UPI Lite ₹260</div>
            <div class="text-[10px] app-muted mt-0.5">Expense • Food</div>
          </button>
          <button onclick="triggerBackgroundUpi('Bank', 350, 'Petrol', 'BPCL Petrol Pump', false)" class="p-3 rounded-2xl app-elevated hover:border-[#38BDF8] transition active:scale-95">
            <div class="text-xs font-extrabold text-sky-400">⛽ GPay ₹350</div>
            <div class="text-[10px] app-muted mt-0.5">Expense • Petrol</div>
          </button>
          <button onclick="triggerBackgroundUpi('Bank', 38500, 'Salary', 'Monthly Salary Credited', true)" class="p-3 rounded-2xl app-elevated hover:border-emerald-400 transition active:scale-95">
            <div class="text-xs font-extrabold text-emerald-400">💰 Salary ₹38,500</div>
            <div class="text-[10px] app-muted mt-0.5">Income (+) • Bank NEFT</div>
          </button>
          <button onclick="triggerBackgroundUpi('Bank', 2500, 'Other Income', 'Freelance / Cashback', true)" class="p-3 rounded-2xl app-elevated hover:border-emerald-400 transition active:scale-95">
            <div class="text-xs font-extrabold text-emerald-400">💵 Received ₹2,500</div>
            <div class="text-[10px] app-muted mt-0.5">Income (+) • UPI Credit</div>
          </button>
        </div>

        <button onclick="toggleBackgroundSimulation()" class="w-full py-3 rounded-2xl app-gradient-btn font-extrabold text-xs shadow-lg">
          Return to Simple Budget App
        </button>
      </div>
    </div>

    <!-- ========================================================== -->
    <!-- FOREGROUND APP VIEW                                        -->
    <!-- ========================================================== -->
    <div id="foregroundAppContainer" class="flex-1 flex flex-col">

      <!-- APP HEADER -->
      <header class="px-4 pt-3 pb-2 flex items-center justify-between gap-2">
        <div class="flex items-center gap-2.5 min-w-0">
          <div id="headerMascotBox" onclick="cycleMascotMood()" title="Tap to preview Penny's moods"
               class="w-12 h-12 rounded-2xl app-card flex items-center justify-center cursor-pointer shrink-0 shadow-md relative">
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5">
              <h1 class="text-base font-extrabold tracking-tight truncate">Simple Budget</h1>
              <span id="mascotMoodBadge" class="text-[9.5px] font-mono uppercase px-2 py-0.5 rounded-full app-elevated font-bold text-[#38BDF8]">CALM</span>
            </div>
            <p id="mascotStatusLine" class="text-[11px] app-muted truncate">Penny: Spending is right on track!</p>
          </div>
        </div>

        <div class="flex items-center gap-1.5 shrink-0">
          <!-- Quick OCR Receipt Camera Button -->
          <button onclick="openReceiptScannerModal()" title="Scan Receipt (OCR)" class="p-2 rounded-xl app-card hover:border-[#38BDF8] text-xs font-bold flex items-center gap-1 active:scale-95 transition">
            <span>📸</span>
            <span class="text-[10px] hidden sm:inline">OCR</span>
          </button>
          <!-- Month Selector -->
          <div class="app-card px-2.5 py-1.5 rounded-xl">
            <select id="activeMonthSelect" onchange="changeActiveMonth(this.value)" class="bg-transparent text-xs font-mono font-extrabold outline-none cursor-pointer text-[#38BDF8]">
              <option value="NOV26" class="bg-[#091E17] text-white">NOV26</option>
              <option value="OCT26" class="bg-[#091E17] text-white">OCT26</option>
              <option value="SEP26" class="bg-[#091E17] text-white">SEP26</option>
              <option value="AUG26" class="bg-[#091E17] text-white">AUG26</option>
            </select>
          </div>
        </div>
      </header>

      <!-- MAIN TAB CONTENT -->
      <main class="flex-1 px-4 pt-1 space-y-4">

        <!-- ====================================================== -->
        <!-- TAB 1: HOME (CLEAN GOALS + TRANSACTIONS / GRAPHICS)    -->
        <!-- ====================================================== -->
        <section id="view-home" class="space-y-3.5">
          
          <!-- Hero Balance & Monthly Budget Bar -->
          <div class="app-card rounded-3xl p-4 shadow-xl space-y-3 relative overflow-hidden">
            <div class="flex items-center justify-between gap-2">
              <div>
                <span id="monthHeaderLabel" class="text-[10px] font-mono uppercase tracking-wider app-muted">NOV26</span>
                <div class="flex items-baseline gap-2 mt-0.5">
                  <span id="heroLeftBalance" class="text-2xl font-mono font-extrabold text-[#38BDF8]">₹0</span>
                  <span class="text-[11px] app-muted">Balance</span>
                </div>
              </div>
              <button onclick="openAddEntryModal()" class="app-gradient-btn px-4 py-2.5 rounded-2xl font-extrabold text-xs shadow-lg active:scale-95 transition">
                + Add Entry
              </button>
            </div>

            <!-- Total Spent vs Total Earned Cards -->
            <div class="grid grid-cols-2 gap-2.5">
              <div class="p-3 rounded-2xl app-elevated flex items-center justify-between">
                <div>
                  <div class="text-[10px] app-muted uppercase font-semibold">Spent</div>
                  <div id="heroTotalExpense" class="text-sm font-mono font-extrabold mt-0.5 text-rose-400">₹0</div>
                </div>
                <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-lg bg-rose-500/15 text-rose-400">OUT</span>
              </div>
              <div class="p-3 rounded-2xl app-elevated flex items-center justify-between">
                <div>
                  <div class="text-[10px] app-muted uppercase font-semibold">Earned</div>
                  <div id="heroTotalIncome" class="text-sm font-mono font-extrabold mt-0.5 text-emerald-400">₹0</div>
                </div>
                <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-lg bg-emerald-500/15 text-emerald-400">IN</span>
              </div>
            </div>

            <!-- Monthly Expense Target Progress Bar -->
            <div class="space-y-1.5 pt-0.5">
              <div class="flex items-center justify-between text-[11px]">
                <span class="app-muted font-medium">Monthly Limit (<span id="budgetTargetLabel" class="font-mono text-white">₹15,000</span>)</span>
                <button onclick="promptMonthlyBudget()" class="text-[#38BDF8] font-mono font-bold underline">Edit</button>
              </div>
              <div class="w-full h-2 bg-black/40 rounded-full overflow-hidden">
                <div id="budgetProgressBar" class="h-full rounded-full transition-all duration-500 bg-gradient-to-r from-[#38BDF8] to-[#10B981]" style="width: 0%"></div>
              </div>
              <div class="flex justify-between text-[10px] font-mono app-muted">
                <span id="budgetPctText">0% used</span>
                <span id="budgetRemainingText">₹15,000 left</span>
              </div>
            </div>
          </div>

          <!-- CLEAN GOALS STRIP ON HOME SCREEN -->
          <div class="app-card rounded-3xl p-3.5 shadow-lg space-y-2.5">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
