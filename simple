          const hrsLeft = Math.max(1, Math.ceil((ONE_DAY_MS - (Date.now() - state.permissions.lastAskedTimestamp)) / 3600000));
          nextClock.textContent = `Next Auto-Prompt in ~${hrsLeft}h`;
