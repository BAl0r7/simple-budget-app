    function runDueRecurringNow() {
      state.recurringRules.forEach(r => {
        state.sheets[state.activeMonth].unshift({
          id: 'rec_tx_' + Date.now() + '_' + Math.random().toString(36).slice(2, 5),
          date: `${r.day}-Nov`,
          paymentType: r.paymentType,
          category: r.category,
          description: `${r.title} (Auto-Recurring)`,
          expense: r.type === 'expense' ? r.amount : 0,
