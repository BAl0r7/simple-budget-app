    function renderCalendarGrid() {
      const monthIdx = Number(document.getElementById('calMonthSelect').value);
      const year = Number(document.getElementById('calYearSelect').value);
      const firstDay = new Date(year, monthIdx, 1).getDay();
      const daysInMonth = new Date(year, monthIdx + 1, 0).getDate();
      const container = document.getElementById('calendarDaysContainer');
      if (!container) return;

      let html = '';
      for (let i = 0; i < firstDay; i++) {
        html += `<div></div>`;
      }
      const mShort = MONTH_NAMES_SHORT[monthIdx];
      for (let d = 1; d <= daysInMonth; d++) {
        const formatted = `${d}-${mShort}`;
        const isSel = (state.calendarTarget === 'island' ? state.islandDate : state.selectedDate) === formatted;
        html += `
          <button type="button" onclick="pickCalendarDay('${formatted}')"
                  class="py-2 rounded-xl font-bold ${isSel ? 'app-gradient-btn' : 'app-elevated hover:border-[#38BDF8]'}">
            ${d}
          </button>
        `;
      }
      container.innerHTML = html;
    }

    function pickCalendarDay(formattedDate) {
      if (state.calendarTarget === 'island') {
        state.islandDate = formattedDate;
        document.getElementById('islandDateText').textContent = formattedDate;
      } else {
        state.selectedDate = formattedDate;
        document.getElementById('modalDateDisplay').textContent = formattedDate;
      }
      closeCalendarModal();
    }

