    function renderComparisonTab() {
      const cur = state.currency;
      const chipsEl = document.getElementById('multiMonthCompareChips');
      if (chipsEl) {
        chipsEl.innerHTML = ALL_MONTH_KEYS.map(m => {
          const active = state.compareSelectedMonths.includes(m);
          return `
            <button onclick="toggleCompareMonthChip('${m}')"
                    class="px-3 py-1.5 rounded-xl text-xs font-mono font-extrabold ${active ? 'app-gradient-btn' : 'app-elevated opacity-70'}">
              ${active ? '✓ ' : ''}${m}
            </button>
          `;
        }).join('');
      }

      const selected = state.compareSelectedMonths;
      const statsMap = {};
      let maxVal = 1;
      selected.forEach(m => {
        statsMap[m] = getMonthStats(m);
        maxVal = Math.max(maxVal, statsMap[m].expense, statsMap[m].income);
      });

      // Visual Grouped Bar Chart
      const chartBox = document.getElementById('multiMonthVisualChart');
      if (chartBox) {
        chartBox.innerHTML = selected.map(m => {
          const st = statsMap[m];
          const expPct = Math.max(4, Math.round((st.expense / maxVal) * 100));
          const incPct = Math.max(4, Math.round((st.income / maxVal) * 100));
          return `
            <div class="space-y-1">
              <div class="flex justify-between text-[11px] font-mono">
                <span class="font-extrabold text-white">${m}</span>
                <div class="flex gap-3">
                  <span class="text-rose-400">Out: ${cur}${st.expense.toLocaleString('en-IN')}</span>
                  <span class="text-emerald-400">In: ${cur}${st.income.toLocaleString('en-IN')}</span>
                </div>
              </div>
              <div class="w-full h-2 bg-black/40 rounded-full overflow-hidden flex gap-0.5">
                <div class="h-full bg-rose-400 rounded-full" style="width:${expPct}%"></div>
              </div>
              <div class="w-full h-1.5 bg-black/40 rounded-full overflow-hidden">
                <div class="h-full bg-emerald-400 rounded-full" style="width:${incPct}%"></div>
              </div>
            </div>
          `;
        }).join('');
      }

      // Summary Cards
      const cardsEl = document.getElementById('compareSummaryCards');
      if (cardsEl) {
        cardsEl.innerHTML = selected.map(m => {
          const st = statsMap[m];
          return `
            <div class="p-3 rounded-2xl app-elevated space-y-1">
              <div class="text-xs font-mono font-extrabold text-[#38BDF8]">${m}</div>
              <div class="text-[11px] flex justify-between"><span>Spent:</span><span class="font-mono font-bold text-rose-400">${cur}${st.expense.toLocaleString('en-IN')}</span></div>
              <div class="text-[11px] flex justify-between"><span>Net:</span><span class="font-mono font-bold text-emerald-400">${cur}${st.balance.toLocaleString('en-IN')}</span></div>
            </div>
          `;
        }).join('');
      }

      // Active Month Payment Breakdown
      document.getElementById('compareActiveMonthTag').textContent = state.activeMonth;
      const activeStats = getMonthStats(state.activeMonth);
      const payEl = document.getElementById('analyticsPaymentBreakdown');
      if (payEl) {
        payEl.innerHTML = state.paymentMethods.map(p => {
          const amt = activeStats.payTotals[p] || 0;
          return `
            <div class="p-2.5 rounded-xl app-elevated flex items-center justify-between text-xs">
              <span class="font-bold">${p}</span>
              <span class="font-mono font-extrabold text-[#38BDF8]">${cur}${amt.toLocaleString('en-IN')}</span>
            </div>
