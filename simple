    }

    // ==============================================================
    // CORE DASHBOARD, TRANSACTIONS & VISUAL GRAPHICS ENGINE
    // ==============================================================
    function getMonthStats(monthKey) {
      const rows = state.sheets[monthKey] || [];
      let expense = 0;
      let income = 0;
      const catExpense = {};
      const catIncome = {};
      const payTotals = {};

      rows.forEach(r => {
        const exp = Number(r.expense) || 0;
        const inc = Number(r.income) || 0;
        expense += exp;
        income += inc;
        if (exp > 0) {
          catExpense[r.category] = (catExpense[r.category] || 0) + exp;
          payTotals[r.paymentType] = (payTotals[r.paymentType] || 0) + exp;
        }
        if (inc > 0) {
          catIncome[r.category] = (catIncome[r.category] || 0) + inc;
        }
      });

      return {
        rows,
        expense,
        income,
        balance: income - expense,
        catExpense,
        catIncome,
        payTotals
      };
    }

