                </div>
              </div>
              <div class="w-full h-2 bg-black/40 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-[#38BDF8] to-[#10B981]" style="width:${pct}%"></div>
              </div>
            </div>
          `;
        }).join('');
      }
    }

    function addMoneyToGoal(id, amount) {
      const g = state.piggyGoals.find(x => x.id === id);
      if (!g) return;
      g.saved = Number(g.saved || 0) + amount;
      saveState();
      renderGoals();
      showToast(`Added ${state.currency}${amount} to ${g.title}!`);
    }

    function createNewPiggyGoal() {
      const title = document.getElementById('piggyTitleInput').value.trim();
      const target = Number(document.getElementById('piggyTargetInput').value) || 0;
      if (!title || target <= 0) {
        showToast('Enter a valid goal name and target amount');
        return;
      }
      state.piggyGoals.push({ id: 'pig_' + Date.now(), title, target, saved: 0 });
      document.getElementById('piggyTitleInput').value = '';
      document.getElementById('piggyTargetInput').value = '';
      saveState();
      renderGoals();
      showToast(`Goal "${title}" created!`);
    }

    function deleteGoal(id) {
      state.piggyGoals = state.piggyGoals.filter(g => g.id !== id);
      saveState();
      renderGoals();
    }

    function openReceiptScannerModal() {
      if (state.permissions.camera !== 'granted') {
        openPermissionModal(true);
        showToast('Camera permission needed for Receipt OCR');
        return;
      }
      document.getElementById('ocrExtractedPreview').classList.add('hidden');
      document.getElementById('receiptScannerModal').classList.remove('hidden');
    }

    function closeReceiptScannerModal() {
      document.getElementById('receiptScannerModal').classList.add('hidden');
    }

    function simulateReceiptOcr(merchant, amount, category, paymentType) {
      pendingOcrResult = { merchant, amount, category, paymentType };
      document.getElementById('ocrMerchantText').textContent = `${merchant} (${category})`;
      document.getElementById('ocrAmountText').textContent = `${state.currency}${amount}`;
      document.getElementById('ocrExtractedPreview').classList.remove('hidden');
    }

    function handleReceiptImageUpload(e) {
      const file = e.target.files?.[0];
      if (!file) return;
      simulateReceiptOcr(file.name.replace(/\.[^.]+$/, ''), 420, 'Shopping', 'UPI Lite');
    }

    function confirmOcrToEntryModal() {
      if (!pendingOcrResult) return;
      closeReceiptScannerModal();
      openAddEntryModal();
      setModalType('expense');
      state.selectedCategory = pendingOcrResult.category;
      state.selectedPayment = pendingOcrResult.paymentType;
      document.getElementById('modalAmountInput').value = pendingOcrResult.amount;
      document.getElementById('modalDescInput').value = pendingOcrResult.merchant;
      renderModalChips();
      updateModalMascotPreview();
    }

    function renderAll() {
      renderHeaderAndMascot();
      renderHomeDashboard();
      renderGoals();
      renderComparisonTab();
      renderNothingNotepad();
      renderCategoriesAndPaymentsManager();
      renderPermissionBannerAndSettings();
    }

    // ==============================================================
    // MODERN FINANCIAL MEMO PAD & REARRANGE CATEGORIES
    // ==============================================================
    function renderNothingNotepad() {
      const grid = document.getElementById('nothingNotesGrid');
      const titleInp = document.getElementById('nothingNoteTitle');
      const bodyInp = document.getElementById('nothingNoteBody');
      const charCount = document.getElementById('memoCharCount');
      const timeBadge = document.getElementById('nothingNoteTimestamp');
      if (!grid || !titleInp || !bodyInp) return;

      const activeNote = state.nothingNotes.find(n => n.id === state.activeNothingNoteId) || state.nothingNotes[0];
      if (activeNote) {
        state.activeNothingNoteId = activeNote.id;
        if (document.activeElement !== titleInp) titleInp.value = activeNote.title;
        if (document.activeElement !== bodyInp) bodyInp.value = activeNote.body;
        if (charCount) charCount.textContent = `${(activeNote.body || '').length} chars`;
        if (timeBadge) timeBadge.textContent = activeNote.tag || '📌 Memo';
      }

      grid.innerHTML = state.nothingNotes.map(n => {
        const isSel = n.id === state.activeNothingNoteId;
        const preview = (n.body || 'Empty note...').replace(/\n/g, ' ');
        return `
          <div onclick="selectNothingNote('${n.id}')"
               class="min-w-[155px] max-w-[180px] p-3 rounded-2xl cursor-pointer transition shrink-0 flex flex-col justify-between border ${
                 isSel
                   ? 'bg-gradient-to-br from-[#102D23] to-[#0A2536] border-[#38BDF8] shadow-md'
                   : 'app-elevated opacity-80 hover:opacity-100'
               }">
            <div>
              <div class="flex items-center justify-between gap-1.5">
                <span class="text-[9.5px] font-mono font-bold px-2 py-0.5 rounded-md bg-black/30 text-[#38BDF8]">${n.tag || '📌 Memo'}</span>
                <button onclick="deleteNothingNote(event, '${n.id}')" class="text-[11px] app-muted hover:text-rose-400 px-1">✕</button>
              </div>
              <div class="text-xs font-extrabold truncate mt-1.5 text-white">${n.title || 'Untitled Memo'}</div>
            </div>
            <p class="text-[10.5px] app-muted truncate mt-1">${preview}</p>
          </div>
        `;
      }).join('');
    }

    function selectNothingNote(id) {
      state.activeNothingNoteId = id;
      saveState();
      renderNothingNotepad();
    }

    function saveCurrentNothingNote() {
      const titleInp = document.getElementById('nothingNoteTitle');
      const bodyInp = document.getElementById('nothingNoteBody');
      const charCount = document.getElementById('memoCharCount');
      const note = state.nothingNotes.find(n => n.id === state.activeNothingNoteId);
      if (note) {
        note.title = titleInp.value || 'Untitled Memo';
        note.body = bodyInp.value;
        if (charCount) charCount.textContent = `${note.body.length} chars`;
        saveState();
        renderNothingNotepad();
      }
    }

    function insertMemoSnippet(snippet) {
      const bodyInp = document.getElementById('nothingNoteBody');
      if (!bodyInp) return;
      const start = bodyInp.selectionStart || bodyInp.value.length;
      const end = bodyInp.selectionEnd || bodyInp.value.length;
      const val = bodyInp.value;
      const prefix = (snippet === '☐ ' || snippet === '• ') && start > 0 && val[start - 1] !== '\n' ? '\n' : '';
      bodyInp.value = val.slice(0, start) + prefix + snippet + val.slice(end);
      bodyInp.focus();
      saveCurrentNothingNote();
    }

    function setMemoTag(tag) {
      const note = state.nothingNotes.find(n => n.id === state.activeNothingNoteId);
      if (!note) return;
      note.tag = tag;
      saveState();
      renderNothingNotepad();
      showToast(`Tagged as ${tag}`);
    }

    function copyCurrentMemo() {
      const note = state.nothingNotes.find(n => n.id === state.activeNothingNoteId);
      if (!note) return;
      const ta = document.createElement('textarea');
      ta.value = `${note.title}\n\n${note.body}`;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      showToast('Memo copied to clipboard!');
    }

    function addNothingNote() {
      const newId = 'nn_' + Date.now();
      state.nothingNotes.unshift({ id: newId, title: 'New Memo', tag: '📌 Pinned', body: '☐ ', updated: 'Just now' });
      state.activeNothingNoteId = newId;
      saveState();
      renderNothingNotepad();
      document.getElementById('nothingNoteTitle')?.focus();
    }

    function clearNothingNote() {
      document.getElementById('nothingNoteBody').value = '';
      saveCurrentNothingNote();
    }

    function deleteNothingNote(e, id) {
      e.stopPropagation();
      if (state.nothingNotes.length <= 1) {
        clearNothingNote();
        return;
      }
      state.nothingNotes = state.nothingNotes.filter(n => n.id !== id);
      state.activeNothingNoteId = state.nothingNotes[0].id;
      saveState();
      renderNothingNotepad();
    }

    function renderCategoriesAndPaymentsManager() {
      const catEl = document.getElementById('manageCategoriesList');
      if (catEl) {
        catEl.innerHTML = state.expenseCategories.map((c, idx) => `
          <div class="p-2 rounded-xl app-elevated flex items-center justify-between text-xs">
            <span class="font-bold">${c}</span>
            <div class="flex gap-1">
              <button onclick="moveItem(state.expenseCategories, ${idx}, -1)" class="px-2 py-0.5 rounded bg-black/30">↑</button>
              <button onclick="moveItem(state.expenseCategories, ${idx}, 1)" class="px-2 py-0.5 rounded bg-black/30">↓</button>
            </div>
          </div>
        `).join('');
      }

      const payEl = document.getElementById('managePaymentsList');
      if (payEl) {
        payEl.innerHTML = state.paymentMethods.map((p, idx) => `
          <div class="p-2 rounded-xl app-elevated flex items-center justify-between text-xs">
            <span class="font-bold">${p}</span>
            <div class="flex gap-1">
              <button onclick="moveItem(state.paymentMethods, ${idx}, -1)" class="px-2 py-0.5 rounded bg-black/30">↑</button>
              <button onclick="moveItem(state.paymentMethods, ${idx}, 1)" class="px-2 py-0.5 rounded bg-black/30">↓</button>
            </div>
          </div>
        `).join('');
      }
    }

    function moveItem(arr, index, dir) {
      const target = index + dir;
      if (target < 0 || target >= arr.length) return;
      const temp = arr[index];
      arr[index] = arr[target];
      arr[target] = temp;
      saveState();
      renderAll();
    }

    function addCustomCategory() {
      const val = document.getElementById('newCategoryInput').value.trim();
      const type = document.getElementById('newCategoryType').value;
      if (!val) return;
      if (type === 'income') state.incomeCategories.push(val);
      else state.expenseCategories.push(val);
      document.getElementById('newCategoryInput').value = '';
      saveState();
      renderAll();
      showToast(`Added ${val} category`);
    }

    function addCustomPaymentMethod() {
      const val = document.getElementById('newPaymentInput').value.trim();
      if (!val) return;
      state.paymentMethods.push(val);
      document.getElementById('newPaymentInput').value = '';
      saveState();
      renderAll();
      showToast(`Added ${val} payment method`);
    }

    // ==============================================================
    // SETTINGS: THEMES, 120HZ/BATTERY SAVER, BIOMETRICS, EXCEL, UPI STATEMENT
    // ==============================================================
    function applyTheme(themeName) {
      state.theme = themeName;
      document.body.classList.remove('theme-ocean', 'theme-oled', 'theme-paper');
      if (themeName === 'ocean') document.body.classList.add('theme-ocean');
      if (themeName === 'oled') document.body.classList.add('theme-oled');
      if (themeName === 'paper') document.body.classList.add('theme-paper');
      saveState();
      showToast(`Theme switched to ${themeName.toUpperCase()}`);
    }

    function setPerformanceMode(mode) {
      state.perfMode = mode;
      document.body.classList.remove('perf-saver');
      if (mode === 'saver') {
        document.body.classList.add('perf-saver');
        document.documentElement.style.setProperty('--anim-speed', '0s');
      } else if (mode === '60hz') {
        document.documentElement.style.setProperty('--anim-speed', '0.22s');
      } else {
        document.documentElement.style.setProperty('--anim-speed', '0.34s');
      }
      ['120hz', '60hz', 'saver'].forEach(m => {
        const el = document.getElementById(`perf-${m}`);
        if (el) el.className = m === mode ? 'p-2.5 rounded-2xl app-gradient-btn text-center' : 'p-2.5 rounded-2xl app-elevated text-center';
      });
      saveState();
      showToast(`Performance set to ${mode.toUpperCase()}`);
    }

    function changeCurrency(sym) {
      state.currency = sym;
      saveState();
      renderAll();
    }

    function promptMonthlyBudget() {
      const next = Math.round(state.monthlyBudgetLimit === 15000 ? 20000 : (state.monthlyBudgetLimit === 20000 ? 12000 : 15000));
      state.monthlyBudgetLimit = next;
      saveState();
      renderAll();
      showToast(`Monthly Target cycled to ${state.currency}${next.toLocaleString('en-IN')}`);
    }

    function toggleBiometricSetting(checked) {
      state.biometricEnabled = checked;
      saveState();
      showToast(checked ? 'Biometric Lock Enabled' : 'Biometric Lock Disabled');
    }

    function lockAppNow() {
      document.getElementById('biometricLockOverlay').classList.remove('hidden');
    }

    function unlockWithBiometrics() {
      document.getElementById('biometricLockOverlay').classList.add('hidden');
      showToast('Unlocked via Biometrics ✓');
    }

    function exportToExcelWorkbook() {
      const wb = XLSX.utils.book_new();
      Object.keys(state.sheets).forEach(monthKey => {
        const rows = state.sheets[monthKey].map(r => ({
          Date: r.date,
          'Payment Type': r.paymentType,
          Category: r.category,
          Description: r.description,
          Expense: r.expense || '',
          Income: r.income || ''
        }));
        const ws = XLSX.utils.json_to_sheet(rows);
        XLSX.utils.book_append_sheet(wb, ws, monthKey);
      });
      XLSX.writeFile(wb, `SimpleBudget_Backup_${state.activeMonth}.xlsx`);
      showToast('Multi-Tab Excel (.xlsx) Backup Downloaded!');
    }

    function importFromExcelWorkbook(e) {
      const file = e.target.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(evt) {
        const data = new Uint8Array(evt.target.result);
        const wb = XLSX.read(data, { type: 'array' });
        let restoredCount = 0;
        wb.SheetNames.forEach(sheetName => {
          const rows = XLSX.utils.sheet_to_json(wb.Sheets[sheetName]);
          if (!state.sheets[sheetName]) state.sheets[sheetName] = [];
          rows.forEach(r => {
            if (r.Date && (r.Expense || r.Income)) {
              state.sheets[sheetName].push({
                id: 'imp_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
                date: String(r.Date),
                paymentType: r['Payment Type'] || 'UPI Lite',
                category: r.Category || 'Food',
                description: r.Description || '',
                expense: Number(r.Expense) || 0,
                income: Number(r.Income) || 0
              });
              restoredCount++;
            }
          });
        });
        saveState();
        renderAll();
        showToast(`Restored ${restoredCount} rows from Excel!`);
      };
      reader.readAsArrayBuffer(file);
    }

    function loadSampleUpiStatement() {
      document.getElementById('statementRawInput').value =
        `06-Nov, Paid ₹190 to New Shalimar Biryani via UPI Lite\n07-Nov, Paid ₹310 to Reliance BP Petrol via GPay\n08-Nov, Credited ₹1500 Cashback Bonus to Bank`;
      parseStatementCandidates();
    }

    function parseStatementCandidates() {
      const raw = document.getElementById('statementRawInput').value.trim();
      if (!raw) return;
      const lines = raw.split('\n');
      statementCandidates = lines.map((line, i) => {
        const amtMatch = line.match(/(?:₹|rs\.?|inr)?\s*(\d+(?:\.\d{1,2})?)/i);
        const amt = amtMatch ? Number(amtMatch[1]) : 150;
        const isInc = /credit|salary|received|bonus/i.test(line);
        const cat = isInc ? 'Other Income' : (/petrol|fuel|bp/i.test(line) ? 'Petrol' : 'Food');
        return { id: i, text: line, amount: amt, isInc, category: cat, checked: true };
      });

      const box = document.getElementById('statementCandidatesContainer');
      box.classList.remove('hidden');
      box.innerHTML = statementCandidates.map((c, idx) => `
        <label class="p-2.5 rounded-xl app-elevated flex items-center justify-between text-xs cursor-pointer">
          <div class="flex items-center gap-2">
            <input type="checkbox" checked onchange="statementCandidates[${idx}].checked = this.checked" class="accent-[#10B981]" />
            <span>${c.category}: ${c.text.slice(0, 34)}...</span>
          </div>
          <span class="font-mono font-bold ${c.isInc ? 'text-emerald-400' : 'text-rose-400'}">${c.isInc ? '+' : '-'}${state.currency}${c.amount}</span>
        </label>
      `).join('') + `
        <button onclick="confirmStatementImports()" class="w-full py-2.5 rounded-xl app-gradient-btn font-extrabold text-xs">
          ✓ Import Selected Transactions
        </button>
      `;
    }

    function confirmStatementImports() {
      let added = 0;
      statementCandidates.filter(c => c.checked).forEach(c => {
        state.sheets[state.activeMonth].unshift({
          id: 'stmt_' + Date.now() + '_' + added,
          date: '8-Nov',
          paymentType: 'UPI Lite',
          category: c.category,
          description: c.text,
          expense: c.isInc ? 0 : c.amount,
          income: c.isInc ? c.amount : 0
        });
        added++;
      });
      document.getElementById('statementCandidatesContainer').classList.add('hidden');
      saveState();
      renderAll();
      showToast(`Imported ${added} statement transactions!`);
    }

    // ==============================================================
    // NAVIGATION & PERSISTENCE
    // ==============================================================
    function changeActiveMonth(m) {
      state.activeMonth = m;
      saveState();
      renderAll();
    }

    function switchTab(tab) {
      ['home', 'analytics', 'tools', 'settings'].forEach(t => {
        document.getElementById(`view-${t}`).classList.toggle('hidden', t !== tab);
        const navBtn = document.getElementById(`nav-${t}`);
        if (navBtn) {
          navBtn.className = t === tab
            ? 'flex flex-col items-center gap-0.5 py-1 px-4 rounded-2xl font-extrabold text-[#38BDF8]'
            : 'flex flex-col items-center gap-0.5 py-1 px-4 rounded-2xl app-muted';
        }
      });
    }

    function switchToolSubTab(sub) {
      ['notepad', 'piggy', 'categories'].forEach(s => {
        const panel = document.getElementById(`tool-panel-${s}`);
        const btn = document.getElementById(`subtab-${s}`);
        if (panel) panel.classList.toggle('hidden', s !== sub);
        if (btn) {
          btn.className = s === sub
            ? 'px-3.5 py-2 rounded-xl text-xs font-extrabold app-gradient-btn shrink-0'
            : 'px-3.5 py-2 rounded-xl text-xs font-extrabold app-elevated shrink-0';
        }
      });
    }

    function showToast(msg) {
      const box = document.getElementById('toastBox');
      document.getElementById('toastMessage').textContent = msg;
      box.classList.remove('hidden');
      clearTimeout(window.__toastTimer);
      window.__toastTimer = setTimeout(() => box.classList.add('hidden'), 2600);
    }

    function saveState() {
      try {
        localStorage.setItem('simple_budget_commercial_v5', JSON.stringify(state));
      } catch (e) {}
    }

    function loadState() {
      try {
        const raw = localStorage.getItem('simple_budget_commercial_v5');
        if (raw) {
          const parsed = JSON.parse(raw);
          state = { ...state, ...parsed, sheets: { ...state.sheets, ...(parsed.sheets || {}) } };
        }
      } catch (e) {}
    }

    window.onload = function() {
      loadState();
      applyTheme(state.theme || 'emerald');
      setPerformanceMode(state.perfMode || '120hz');
      document.getElementById('currencySelect').value = state.currency || '₹';
      document.getElementById('biometricToggle').checked = !!state.biometricEnabled;
      document.getElementById('nothingNoteTitle')?.addEventListener('input', saveCurrentNothingNote);
      if (state.biometricEnabled) lockAppNow();
      renderAll();
      // Trigger Smart Permission Check (asks once every 24h if any required permission is denied/missing)
      checkDailyPermissionPrompt(false);
    };
  </script>
</body>
