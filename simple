    function syncAmountFromInput(val) {
      state.mathExpr = val;
      document.getElementById('mathExprPreview').textContent = val || '0';
      updateModalMascotPreview();
    }

    function mathKey(k) {
      if (k === 'C') {
        state.mathExpr = '';
      } else if (k === 'BACK') {
        state.mathExpr = state.mathExpr.slice(0, -1);
      } else if (k === '=') {
        try {
          const sanitized = state.mathExpr.replace(/[^0-9+\-*/.]/g, '');
          const result = Function(`"use strict"; return (${sanitized || 0})`)();
          state.mathExpr = String(Math.round(result * 100) / 100);
        } catch (e) {}
      } else {
        state.mathExpr += k;
      }

      document.getElementById('mathExprPreview').textContent = state.mathExpr || '0';
      try {
        const sanitized = state.mathExpr.replace(/[^0-9+\-*/.]/g, '');
        if (sanitized && !/[+\-*/.]$/.test(sanitized)) {
          const val = Function(`"use strict"; return (${sanitized})`)();
          document.getElementById('modalAmountInput').value = Math.round(val * 100) / 100;
        } else {
          document.getElementById('modalAmountInput').value = state.mathExpr;
        }
      } catch (e) {
        document.getElementById('modalAmountInput').value = state.mathExpr;
      }
      updateModalMascotPreview();
    }

    function updateModalMascotPreview() {
      const amt = Number(document.getElementById('modalAmountInput')?.value) || 0;
      const iconBox = document.getElementById('modalMascotIcon');
      const subText = document.getElementById('modalSubText');
      if (!iconBox || !subText) return;

      if (state.modalType === 'income') {
        iconBox.innerHTML = getPennyCatSvg('HAPPY');
        subText.textContent = amt > 0 ? `Penny is purring! +${state.currency}${amt} Income ★` : 'Log your Salary or extra income ★';
      } else if (amt >= 2000) {
        iconBox.innerHTML = getPennyCatSvg('WORRIED');
        subText.textContent = `Big expense (${state.currency}${amt})! Penny is sweating 💧`;
      } else if (amt > 0) {
        iconBox.innerHTML = getPennyCatSvg('WHISTLE');
        subText.textContent = `Penny whistling: Logging ${state.currency}${amt} ♪`;
      } else {
        iconBox.innerHTML = getPennyCatSvg('CALM');
        subText.textContent = 'Penny is ready to log your transaction';
      }
    }

